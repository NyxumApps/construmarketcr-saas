# Copie este archivo como .env y complete los valores.
# El archivo .env no se sube a Git.

# Puertos locales
PORT=3000
API_PORT=8080
API_TARGET=http://127.0.0.1:8080
BASE_PATH=/
NODE_ENV=development
LOG_LEVEL=info

# Base de datos PostgreSQL (Supabase: Project Settings > Database > Connection string)
DATABASE_URL=

# Clerk (autenticación). La clave VITE_ se incrusta en el navegador: solo la publicable.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# IDs de Clerk con rol de administración, separados por comas
ADMIN_CLERK_USER_IDS=

# Firma HMAC de los permisos de carga de imágenes (secreto largo y aleatorio)
SESSION_SECRET=

# Almacenamiento de imágenes. Sin estos valores se usa el disco local en desarrollo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=plan-images
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=.local/storage

# Orígenes de navegador autorizados en producción, separados por comas
ALLOWED_ORIGINS=

# Pasarela de pago. "sandbox" registra la compra sin cobrar.
PAYMENT_PROVIDER=sandbox

# Nunca activar en producción
VITE_E2E_MODE=false
