# Copia este archivo como .env y completa los valores.
# El archivo .env no se sube a Git.

# Puertos locales (opcionales)
# PORT=3000
# API_PORT=8080

# Base de datos PostgreSQL
DATABASE_URL=

# Clerk (autenticación)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Firma de cookies y permisos de carga
SESSION_SECRET=

# Almacenamiento de archivos (hoy depende de Replit)
PRIVATE_OBJECT_DIR=

# Opcionales
# ADMIN_CLERK_USER_IDS=
# VITE_CLERK_PROXY_URL=
# LOG_LEVEL=info
